@unpublished{liu2026withinparty,
  title={Beyond Partisan Mean Gaps: Governing Roles and the Dispersion of Economic Perceptions},
  author={Liu, Muzhi},
  note={Working paper},
  keywords={identity-voting},
  abstract={Research on partisan economic perception compares the two camps' average evaluations. We study their dispersion: whether the governing party's identifiers share an economic perception. A heterogeneous motivated-weighting model predicts dispersion for camps facing incongruent evidence and convergence under congenial or overwhelming evidence. In the ANES 2016–2020–2024 panel, the same individuals sat farther from their party's perception distribution in the waves when it held the presidency — across nominal-disagreement, ordinal-distance, and mean- and median-centered measures, three party-classification estimands, and both parties. The pattern is roughly four times weaker for household finances, and about nine-tenths reflects redistribution within reported personal-finance categories rather than compositional change. Across twenty calendar years, the governing-minus-opposition dispersion gap is wider in worse years, net of stable partisan dispersion differences — driven by opposition convergence, not a detectable governing-camp rise. Discordant governing-camp raters were more likely to defect; redistribution at a fixed mean does not detectably shield incumbents.},
  bibtex_show={true}
}

