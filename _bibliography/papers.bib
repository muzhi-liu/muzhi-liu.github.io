@unpublished{liu2026partisananchors,
  title={Borrowed Battlegrounds: The Formation and Reorganization of Foreign-Language Event-Publics around U.S. Political Violence},
  author={Liu, Muzhi},
  note={Submitted},
  keywords={cross-border},
  abstract={When political violence strikes an American politician, how does it change the discussion mode of foreign publics on social media, and does it generate more attention to U.S. partisan politics, or more interest in discussing American politics online at all? To answer this question, I study 29 U.S. political-violence events from 2010–2025 in five foreign-language streams on X. My data collection combines four query families, covering the discourse associated with each event, its target, and U.S. political parties. From complete daily counts of posts in each query family, probability-sampled text with LLM labels, and a 1.3-million-post targeted collection around the 2024 assassination attempt on Donald Trump and the 2025 assassination of Charlie Kirk, I find the following. First, event-sparked discussion is uneven across events, with lethality being the dominant predictor of discussion volume, while visibility of the target before the event is not a significant predictor. Second, event discussion dilutes standalone party discussion by 21.9 percentage points and non-U.S. political recontextualization by 4 percentage points, pooling nine events, and these estimates are homogeneous across language groups. Their raw counts do not consistently increase. Third, sentiment toward the attacked person moves toward sympathy, with no change in affect toward that person's party. The Trump and Kirk case studies confirm that the pattern holds even in outlier cases that trigger massive global attention: participants are overwhelmingly first-time entrants whose activity decays within days, and changes in semantic outcomes match the nine-event analysis. Finally, topic modeling reveals that discussion is contingent on event details rather than timeless topics about politicians and parties. These results suggest that even the most provocative event class—assassination—produces only short-lived global attention instead of drastically shaping how foreign publics perceive U.S. politics and parties.},
  bibtex_show={true}
}

@unpublished{liu2026estimandfirst,
  title={Estimand-First Comparative Text Analysis: Measuring Discourse Change Across Co-Exposed Platforms},
  author={Liu, Muzhi},
  note={Submitted},
  keywords={cross-border},
  abstract={This project develops an estimand-first framework for comparative text analysis, in which cross-context comparisons of political discourse are organized around explicitly defined target quantities rather than off-the-shelf measurement pipelines. I illustrate the framework with an application to electoral spectatorship — how Chinese-speaking audiences followed and discussed the 2024 U.S. presidential election — combining LLM-assisted labeling of more than 14,000 posts and 379,000 comments from Weibo and Rednote with difference-in-differences designs.},
  bibtex_show={true}
}

