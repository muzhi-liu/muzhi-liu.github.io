@unpublished{liu2026partisananchors,
  title={When Partisan Anchors Make Parties Legible: Transnational Partisan Generalization After U.S. Political Violence},
  author={Liu, Muzhi},
  note={Under review},
  keywords={cross-border},
  abstract={This project examines how foreign audiences use highly visible U.S. political events to interpret partisan conflict. I study whether exposure to U.S. political violence makes party labels more meaningful for global online audiences and changes how they discuss American politics. Using event-study and difference-in-differences designs with LLM-coded measures of partisan engagement on X and Weibo, I trace how party labels become legible abroad.},
  bibtex_show={true}
}

@unpublished{liu2026estimandfirst,
  title={Estimand-First Comparative Text Analysis: Measuring Discourse Change Across Co-Exposed Platforms},
  author={Liu, Muzhi},
  note={Submitted},
  keywords={cross-border},
  abstract={This project develops an estimand-first framework for comparative text analysis, in which cross-context comparisons of political discourse are organized around explicitly defined target quantities rather than off-the-shelf measurement pipelines. I illustrate the framework with an application to electoral spectatorship — how Chinese-speaking audiences followed and discussed the 2024 U.S. presidential election — combining LLM-assisted labeling of more than 14,000 posts and 379,000 comments from Weibo and Rednote with difference-in-differences designs.},
  bibtex_show={true}
}

